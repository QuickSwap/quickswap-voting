# RPC endpoints (optional - defaults to public RPCs)
POLYGON_RPC=https://polygon-mainnet.infura.io/v3/<YOUR_KEY>
BASE_RPC=https://base-mainnet.infura.io/v3/<YOUR_KEY>
ETHEREUM_RPC=https://mainnet.infura.io/v3/<YOUR_KEY>
MANTA_RPC=https://pacific-rpc.manta.network/http

# IMPORTANT: Conract Owner, use multisig address for production
OWNER_ADDRESS=

# Keystore authentication (password prompted at runtime)
KEYSTORE_PATH=keys/key.json

# Block explorer API keys (for contract verification)
POLYGONSCAN_API_KEY=
BASESCAN_API_KEY=
ETHERSCAN_API_KEY=

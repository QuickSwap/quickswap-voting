# Dependencies
node_modules/
.pnpm-store/

# Hardhat
artifacts/
cache/
typechain/
typechain-types/
types/

# Environment
.env
.env.local
.env.*.local

# Keystores (encrypted private keys)
keystores/
*.keystore
*.json.keystore

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Build
dist/
build/
*.tsbuildinfo

# Deployments (local history only - source of truth is config/chains.json)
deployments/*.json
# Keep allowlists committed (governance-controlled inputs)
!deployments/allowlists/
!deployments/allowlists/*.json

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Coverage
coverage/
coverage.json

# Test artifacts (keep baseline-latest.json, ignore timestamped copies)
test/baselines/baseline-*-*.json
!test/baselines/baseline-latest.json

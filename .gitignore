# Dependencies
node_modules/
.pnpm-store/

# Hardhat
artifacts/
cache/
typechain/
typechain-types/
types/

# Environment
.env
.env.local
.env.*.local

# Keystores (encrypted private keys)
keystores/
*.keystore
*.json.keystore

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Build
dist/
build/
*.tsbuildinfo

# Deployments
# - Keep committed "latest" manifests per chain (source of truth for production)
!deployments/*-latest.json
# - Keep allowlists committed (governance-controlled inputs)
!deployments/allowlists/*.json
# - Ignore timestamped deployment runs (local history / noise)
deployments/*-[0-9]*.json
deployments/polygon-algebraV3-[0-9]*.json
deployments/history.json

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Coverage
coverage/
coverage.json

# Test artifacts (keep baseline-latest.json, ignore timestamped copies)
test/baselines/baseline-*-*.json
!test/baselines/baseline-latest.json
